INCLUDE [    if { {BB} == {MINBB} } {       puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_BoundingBoxReplacer_BBFunc @Force2D() @Bounds(fme_encoded,MIN_BOUNDING,,,<Unused>)};    } elseif { {BB} == {BB} } {       puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_BoundingBoxReplacer_BBFunc @Force2D() @Bounds(fme_encoded,BOUNDING_BOX_AXIS_ALIGNED,,)};    } else {       puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_BoundingBoxReplacer_BBFunc @Bounds(fme_encoded,BOUNDING_CUBE,,)};    } ]
