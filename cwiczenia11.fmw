FACTORY_DEF {*} StatisticsCalculatorFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_StatisticsCalculator }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Junction_Output"    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    STATISTIC_SUFFIX_RENAME_MAP { COUNT,_count }    PREPEND_ATTR_NAME { No }    FEAT_STATS { ContentDate.Start,NUMERIC_MODE,,,COUNT,,,,,,,,,, }    ADVANCED_MODE { NO }    CUMULATIVE_STATS {  }    CALCULATION_MODE { NUMERIC }    ATTR_ACCUM_MODE { None }    ATTRIBUTE_NAMES_AND_TYPES { access_token,buffer,_response_body,buffer,Online,buffer,Id,buffer,ContentDate.Start,buffer }    TREAT_INVALID_AS_NULL Yes    OUTPUT { COMPLETE FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_StatisticsCalculator_COMPLETE"        }    OUTPUT { SUMMARY FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_StatisticsCalculator_SUMMARY"        }
