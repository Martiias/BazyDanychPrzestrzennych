encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B2_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B3_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B4_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B5_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B6_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B7_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B8_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B11_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B12_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_TCI_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = YES ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_2) = R20m ENCODED } BOOLEAN_OPERATOR COMPOSITE COMPOSITE_TEST_EXPR "( 1 OR 2 OR 3 OR 4 OR 5 OR 6 OR 7 OR 8 OR 9 