FACTORY_DEF {CONNECTED} CreationFactory    FACTORY_NAME { Emailer_Creator }    OUTPUT { FEATURE_TYPE Emailer_____CREATED______ }
# Note -- the AttachmentTable has to have a SPACE as the first character so that we don't get the *bad*
# FME Parser to start parsing a @ function call -- if @ is the first character, it will, and then we lose
# our table elements :-(
# The python later expects the first character to be a space so all is well.
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { Emailer_CATCHER }    INPUT { FEATURE_TYPE Emailer_____CREATED______ }    INPUT  FEATURE_TYPE Tester_2_FAILED_1_46GY0EoB9+Y=    OUTPUT { FEATURE_TYPE Emailer_READY       @RenameAttributes(FME_STRICT,___fme_rejection_code___,fme_rejection_code)       ___fme_emailer_service           "Generic SMTP"       ___fme_emailer_connection        "HOST;poczta.interia.pl;PORT;465;ENCRYPTION;SSL;TIMEOUT_Generic_SMTP;60;AUTHENTICATION;YES;USERNAME;@EvaluateExpression(FDIV,STRING_ENCODED,$(USER_EMAIL$encode),Emailer);PASSWORD;@EvaluateExpression(FDIV,STRING_ENCODED,$(PASSWORD$encode),Emailer);TIMEOUT;60"       ___fme_emailer_from              "@EvaluateExpression(FDIV,STRING_ENCODED,$(USER_EMAIL$encode),Emailer)"       ___fme_emailer_to                "@EvaluateExpression(FDIV,STRING_ENCODED,$(CLIENT_EMAIL$encode),Emailer)"       ___fme_emailer_cc                ""       ___fme_emailer_bcc               ""       ___fme_emailer_subject           "@EvaluateExpression(FDIV,STRING_ENCODED,B<u0141><u0104>D:<space>Brak<space>danych<space>satelitarnych<space>dla<space>powiatu<space>$(POWIAT$encode),Emailer)"       ___fme_emailer_body              "Przetwarzanie<space>przerwane.<space>Kryteria<space>wyszukiwania<space>nie<space>zosta<u0142>y<space>spe<u0142>nione.<space>Szczeg<u00f3><u0142>y<space>w<space>za<u0142><u0105>czonym<space>pliku<space>GeoJSON."       ___fme_emailer_attachments       " C:<backslash>Dane<backslash>log_bledu.json @EvaluateExpression(FDIV,STRING_ENCODED,,Emailer) autodetect"       ___fme_emailer_xformerName       "Emailer"       ___fme_emailer_headers           " "   }
FACTORY_DEF {*} PythonFactory    FACTORY_NAME { Emailer_CALLER }    INPUT { FEATURE_TYPE Emailer_READY }    PYTHON_NAMESPACE FMEOBJECTS    SYMBOL_NAME fmepy_emailer.Emailer    OUTPUT { PYOUTPUT FEATURE_TYPE Emailer_PROCESSED     @RemoveAttributes(INPUT_PORT_CONNECTED) }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { Emailer_ROUTER }    INPUT { FEATURE_TYPE Emailer_PROCESSED }    TEST &fme_rejection_code == ""    OUTPUT { PASSED FEATURE_TYPE Emailer_Sent         @RenameAttributes(FME_STRICT,fme_rejection_code,___fme_rejection_code___)          }
# -------------------------------------------------------------------------
# The default behaviour is to abort on any feature entering the transformer.
# If Workbench has set the _WB_BYPASS_TERMINATION macro to a value of "Yes",
# then the features will instead be passed through with a feature type of
# __WB_BYPASS_TERMINATOR__, which Workbench will send to a visualizer or
# somesuch.
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF {*} TestFactory    FACTORY_NAME { Terminator }    INPUT  FEATURE_TYPE Emailer_Sent    TEST { "$(_WB_BYPASS_TERMINATION)" == Yes }    OUTPUT { PASSED FEATURE_TYPE __WB_BYPASS_TERMINATOR__       @SupplyAttributes(_wb_termination_feature_type,@FeatureType())       @SupplyAttributes(ENCODED,_wb_termination_message,"Zatrzymano<space>z<space>powodu<space>braku<space>zobrazowa<u0144>")       @SupplyAttributes(_wb_termination_xformer,"Terminator")       @SupplyAttributes(_wb_termination_feature,Yes) }    OUTPUT { FAILED FEATURE_TYPE * @Abort(ENCODED,"Zatrzymano<space>z<space>powodu<space>braku<space>zobrazowa<u0144>") }
