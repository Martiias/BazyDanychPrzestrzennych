GEODATABASE_FILE_1_DEF_TEMPLATE Extents   geodb_type                   {FME_FIRST_ENCOUNTERED_GEOMETRY}   GEODB_UPDATE_KEY_COLUMNS     ""   GEODB_DROP_TABLE             NO   GEODB_TRUNCATE_TABLE         NO   fme_feature_operation        INSERT   fme_table_handling           CREATE_IF_MISSING   GEODB_OBJECT_ID_NAME         OBJECTID   GEODB_OBJECT_ID_ALIAS        OBJECTID   GEODB_SHAPE_NAME             ""   GEODB_SHAPE_ALIAS            SHAPE   GEODB_CONFIG_KEYWORD         DEFAULTS   GEODB_FEATURE_DATASET        ""   GEODB_GRID{1}                ""   GEODB_AVG_NUM_POINTS         ""   GEODB_HAS_Z_VALUES           ""   GEODB_HAS_MEASURES           ""   GEODB_ANNO_REFERENCE_SCALE   ""   GEODB_ZORIGIN                ""   GEODB_XORIGIN                ""   GEODB_MEASURES_SCALE         ""   GEODB_ZSCALE                 ""   GEODB_XYSCALE                ""   fme_constant_feature_type    YES   GEODB_YORIGIN                ""   GEODB_MEASURES_ORIGIN        ""   fme_schema_feature_first     no   fme_geometry_name:SHAPE      spatial_type,   NewName                      char(33)   Xmin                         double   Xmax                         double   Ymin                         double   Ymax                         double
